{
  "name": "spec-renderer",
  "displayName": "Spec Renderer",
  "description": "Browse OpenAPI and Swagger specs from the Activity Bar and copy ready-to-run cURL commands.",
  "version": "0.2.0",
  "publisher": "your-publisher-id",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ThermalDust095/SpecRenderer.git"
  },
  "bugs": {
    "url": "https://github.com/ThermalDust095/SpecRenderer/issues"
  },
  "keywords": [
    "openapi",
    "swagger",
    "curl",
    "api",
    "rest"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "main": "./dist/extension.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p . --noEmit && tsc -p src/webview --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test \"out/test/**/*.test.js\"",
    "icon": "node scripts/render-icon.mjs",
    "package": "vsce package",
    "vscode:prepublish": "npm run typecheck && node scripts/build.mjs --production"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@types/node": "^22.15.30",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.25.5",
    "openapi-types": "^12.1.3",
    "typescript": "^5.8.3"
  },
  "contributes": {
    "commands": [
      {
        "command": "specRenderer.refresh",
        "title": "Refresh Spec",
        "category": "Spec Renderer",
        "icon": "$(refresh)"
      },
      {
        "command": "specRenderer.setSpecUrl",
        "title": "Set Spec URL",
        "category": "Spec Renderer",
        "icon": "$(link)"
      },
      {
        "command": "specRenderer.collapseAll",
        "title": "Collapse All Modules",
        "category": "Spec Renderer",
        "icon": "$(collapse-all)"
      }
    ],
    "configuration": {
      "title": "Spec Renderer",
      "properties": {
        "specRenderer.specUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "URL of an OpenAPI 3.x or Swagger 2.0 document (JSON or YAML). A docs page such as `http://localhost:8000/docs` also works: the spec is discovered automatically."
        },
        "specRenderer.openEndpointIn": {
          "type": "string",
          "enum": ["activeGroup", "beside"],
          "enumDescriptions": [
            "Open endpoint details as a tab in the editor group you're working in.",
            "Open endpoint details in a split editor group next to the active editor."
          ],
          "default": "activeGroup",
          "description": "Where the endpoint details tab opens the first time you click an endpoint. After that, the same tab is reused wherever it is."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "specRenderer",
          "title": "Spec Renderer",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "specRenderer": [
        {
          "id": "specRenderer.endpoints",
          "name": "Endpoints",
          "type": "webview"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "specRenderer.setSpecUrl",
          "when": "view == specRenderer.endpoints",
          "group": "navigation@1"
        },
        {
          "command": "specRenderer.refresh",
          "when": "view == specRenderer.endpoints",
          "group": "navigation@2"
        },
        {
          "command": "specRenderer.collapseAll",
          "when": "view == specRenderer.endpoints",
          "group": "navigation@3"
        }
      ]
    }
  }
}
